<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentic.sdlc</groupId>
        <artifactId>agentic-sdlc-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>agentic-orchestrator</artifactId>
    <packaging>jar</packaging>

    <name>Agentic Orchestrator</name>
    <description>
        Framework-agnostic SDLC orchestration engine: dependency-graph-based stage
        execution with entry/exit gates, human approval checkpoints, bounded
        retries/rollback/safe-stop, policy guardrails, audit-grade observability,
        reliability metrics, and dynamic re-planning. Deliberately has no dependency
        on Spring or any web framework -- it orchestrates work, it does not serve it.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
        <!--
            Forced explicitly: Spring Boot's dependencyManagement BOM (imported
            in the parent pom) pins logback-core to a version older than the
            logback-classic release above, and logback-classic 1.5.x is not
            binary-compatible with logback-core < 1.5. Without this override
            Maven resolves the mismatched pair and logging fails at class-init.
        -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <version>${logback.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.25.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
